{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chanre-care-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-03",
  "containers": [
    {
      "class_name": "BackendContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND_CONTAINER",
        "class_name": "BackendContainer"
      }
    ]
  },
  "exports": {
    "BackendContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
